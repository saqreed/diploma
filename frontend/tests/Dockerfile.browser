# Isolated local QA only. No application data or secrets are copied into this image.
FROM python:3.12.14-slim-bookworm
ARG QA_NODE_VERSION=24.19.0
ARG QA_CHROME_VERSION=154.0.8037.92
ARG QA_FIREFOX_VERSION=157.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 \
      "https://nodejs.org/dist/v${QA_NODE_VERSION}/node-v${QA_NODE_VERSION}-linux-x64.tar.xz" -o /tmp/qa-node.tar.xz \
    && tar -xf /tmp/qa-node.tar.xz -C /usr/local --strip-components=1 \
    && rm /tmp/qa-node.tar.xz
WORKDIR /qa/runtime
RUN npm install --no-audit --no-fund playwright@1.62.1 \
    && npx playwright install-deps chromium firefox \
    && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 \
      "https://storage.googleapis.com/chrome-for-testing-public/${QA_CHROME_VERSION}/linux64/chrome-linux64.zip" -o /tmp/qa-chrome.zip \
    && unzip -q /tmp/qa-chrome.zip -d /opt/qa-browsers \
    && curl --fail --location --retry 3 \
      "https://archive.mozilla.org/pub/firefox/releases/${QA_FIREFOX_VERSION}/linux-x86_64/en-US/firefox-${QA_FIREFOX_VERSION}.tar.xz" -o /tmp/qa-firefox.tar.xz \
    && tar -xf /tmp/qa-firefox.tar.xz -C /opt/qa-browsers \
    && rm /tmp/qa-chrome.zip /tmp/qa-firefox.tar.xz
COPY browser-acceptance.cjs browser-editor.cjs browser-input.cjs run-browser.cjs local-qa-server.cjs /qa/repository/frontend/tests/
ENV PLAYWRIGHT_MODULE=/qa/runtime/node_modules/playwright \
    QA_FIXTURE_CACHE=/qa/fixture.json \
    QA_SCREENSHOTS=/qa/screenshots \
    QA_BACKEND_URL=http://backend:8000
WORKDIR /qa/repository/frontend
CMD ["node", "tests/local-qa-server.cjs"]
