# Backend application settings
DIPLOMA_APP_NAME=Three-Factor Authentication API
DIPLOMA_APP_VERSION=0.1.0
DIPLOMA_ENVIRONMENT=development
DIPLOMA_DEBUG=false

# Local PostgreSQL defaults; use secret-managed credentials outside development.
DIPLOMA_DATABASE_URL=postgresql+asyncpg://diploma:diploma@localhost:5432/diploma
DIPLOMA_DATABASE_POOL_SIZE=5
DIPLOMA_DATABASE_MAX_OVERFLOW=5
DIPLOMA_DATABASE_POOL_TIMEOUT_SECONDS=30
DIPLOMA_DATABASE_POOL_RECYCLE_SECONDS=1800
