# Backend application settings
DIPLOMA_APP_NAME=Система настраиваемых правил антифрода
DIPLOMA_APP_VERSION=0.1.0
DIPLOMA_ENVIRONMENT=development
DIPLOMA_DEBUG=false

# Run scripts/prepare-local.ps1 to generate missing local secrets in ignored .env.
POSTGRES_DB=diploma
POSTGRES_USER=diploma
# POSTGRES_PASSWORD, DIPLOMA_AF_PASSWORD, DIPLOMA_DEMO_PASSWORD,
# DIPLOMA_READER_PASSWORD, DIPLOMA_SEED_PASSWORD, DIPLOMA_DEMO_API_KEY,
# DIPLOMA_SOURCE_ENCRYPTION_KEY are generated locally. Do not commit their values.
DIPLOMA_DATABASE_POOL_SIZE=5
DIPLOMA_DATABASE_MAX_OVERFLOW=5
DIPLOMA_DATABASE_POOL_TIMEOUT_SECONDS=30
DIPLOMA_DATABASE_POOL_RECYCLE_SECONDS=1800
